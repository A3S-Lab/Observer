    },
    {
      "id": "dify-plugin-runtime",
      "role": "agent_root",
      "patterns": ["dify-plugin-daemon"]
    },
    {
      "id": "kimi-cli",
      "role": "agent_root",
      "patterns": ["kimi"]
    },
    {
      "id": "langchain-runtime",
      "role": "agent_root",
      "patterns": ["langchain"]
    },
    {
      "id": "pi-coding-agent",
      "role": "agent_root",
      "patterns": ["pi-coding-agent", "run-pi-"]
    }
  ]
